# Server Port
PORT=4000

# Allowed frontend origins (comma-separated). Leave unset to allow localhost only.
# Example: CORS_ORIGIN=https://receipt-vault.vercel.app
CORS_ORIGIN=

# JWT Authentication
JWT_SECRET="replace-with-a-robust-random-secret-key"

# Admin Dashboard Protection (/admin/queues)
ADMIN_USER="admin"
ADMIN_PASS="admin123"

# Database Configuration (Prisma)
# SQLite (Local zero-config dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Production / Docker Compose):
# DATABASE_URL="postgresql://receipt_user:receipt_secure_password@localhost:5432/receipt_manager"

# Gemini Multimodal AI Key (Used for Vision OCR and metadata extraction)
GEMINI_API_KEY="your-gemini-api-key"

# Email Account for Expiry Alerts (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="youraddress@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Receipt Vault" <youraddress@gmail.com>'
REMINDER_DAYS_BEFORE=3

# Redis Configuration (BullMQ background queues)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# Alternatively, cloud Redis (e.g. Upstash):
# REDIS_URL="rediss://default:password@host:6379"
