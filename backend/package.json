{
  "name": "receipt-manager-backend",
  "version": "1.0.0",
  "description": "Backend for Universal Digital Receipt Manager",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "npx prisma generate && npx prisma db push && node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@bull-board/api": "^9.10.0",
    "@bull-board/express": "^9.10.0",
    "@google/genai": "^2.19.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "tesseract.js": "^5.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2"
  }
}
